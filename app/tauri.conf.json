{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forever Together",
  "version": "0.1.0",
  "identifier": "com.gitlloop.forevertogether",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../webapp" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../webapp" },
    "frontendDist": "../webapp/dist"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
